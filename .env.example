# ==========================================
# AI Marketplace Assistant Environment Config
# ==========================================

# ------------------------------------------
# Frontend Settings (Next.js)
# ------------------------------------------
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production deployment (Render backend):
# NEXT_PUBLIC_API_URL=https://aima-thu5.onrender.com

# ------------------------------------------
# Backend Settings (FastAPI)
# ------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
# Allowed frontend origin (e.g. your Vercel deployment URL):
FRONTEND_URL=
DEFAULT_AI_PROVIDER=openai

# ------------------------------------------
# OpenAI Provider Settings
# ------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------
# Local Ollama Provider Settings
# ------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ------------------------------------------
# Pinecone Vector Database Settings
# ------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-marketplace-products
PINECONE_ENVIRONMENT=us-east-1
